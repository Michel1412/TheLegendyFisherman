	quest.3ABF451FD174FC74.title: "Faca do marujo"
	quest.3ABF451FD174FC74.quest_subtitle: "Farmer's Delight — faca de sílex"
	quest.3ABF451FD174FC74.quest_desc: [
		"Antes de pescar, aprenda a improvisar no cais."
		""
		"Tenha uma &efaca de sílex&r do Farmer's Delight. Ela abre o caminho para corda, comida e equipamento de pesca."
	]
	quest.1FD3C02A7F7B2188.title: "Corda improvisada"
	quest.1FD3C02A7F7B2188.quest_subtitle: "1× farmersdelight:rope"
	quest.1FD3C02A7F7B2188.quest_desc: [
		"A primeira gambiarra oficial do cais."
		""
		"A &6corda&r substitui o barbante na receita da vara improvisada do TLF."
	]
	quest.6B635D1717E56622.title: "Vara do aprendiz"
	quest.6B635D1717E56622.quest_subtitle: "3 gravetos + 2 cordas"
	quest.6B635D1717E56622.quest_desc: [
		"Agora o graveto virou promessa."
		""
		"Use 3 gravetos e 2 cordas. Esta vara tem apenas &c10 usos&r e sempre conta como tier &7LOW&r."
	]
	quest.A17E7717E0000001.title: "Rede do iniciante"
	quest.A17E7717E0000001.quest_subtitle: "Pegue uma rede e capture um peixe vivo"
	quest.A17E7717E0000001.quest_desc: [
		"Nem todo peixe vira item sozinho."
		""
		"No TLF, alguns peixes aparecem vivos no mundo. Use a &aRede de Pesca&r para entender essa captura de perto."
	]
	quest.A170F151F0000001.title: "Primeira mordida"
	quest.A170F151F0000001.quest_subtitle: "Capture qualquer peixe"
	quest.A170F151F0000001.quest_desc: [
		"A primeira puxada sempre vem com susto."
		""
		"Jogue a linha, espere o bobber afundar e recolha. Depois o Pescador ensina hooks, iscas e minigame."
	]
	quest.7515A04E6573E89D.title: "Lendo as marés (Tiers)"
	quest.7515A04E6573E89D.quest_subtitle: "Glossário rápido"
	quest.7515A04E6573E89D.quest_desc: [
		"&7LOW&r é improviso. &fMEDIUM&r é estabilidade. &aGOOD&r é especialização."
		"&9GREAT&r, &5EXCELLENT&r, &dPERFECT&r e &6LEGENDARY&r são mares cada vez mais raros."
		""
		"As quatro rotas de Aprendiz abrem depois que você entender estes fundamentos."
	]
	quest.A17CA15000000001.title: "O cais te chama"
	quest.A17CA15000000001.quest_subtitle: "Visite um bioma de oceano"
	quest.A17CA15000000001.quest_desc: [
		"O oceano é grande, molhado e levemente julgador."
		""
		"Visite um bioma de oceano. A rota Pescador transforma vara, isca, anzol e boia em equipamento de verdade."
	]
	quest.2B63327585027AE2.title: "Fundamentos concluídos"
	quest.2B63327585027AE2.quest_subtitle: "Desbloqueia as 4 vertentes Aprendiz"
	quest.2B63327585027AE2.quest_desc: [
		"Você tem faca, corda, vara e a primeira história de pescador."
		""
		"As abas &aPescador&r, &6Cozinheiro&r, &7Artesão&r e &bMarinheiro&r liberam ao mesmo tempo."
	]

	quest.09F348FF8189073A.title: "Aprendiz do cais"
	quest.09F348FF8189073A.quest_subtitle: "Bem-vindo à guilda dos pescadores"
	quest.09F348FF8189073A.quest_desc: [
		"A rota do Pescador abre com cheiro de peixe e ego baixo."
		""
		"Aqui você aprende cada parte da vara: linha, anzol, isca, boia e técnica."
	]
	quest.A17CA1C0A1A00001.title: "Caixa de apetrechos"
	quest.A17CA1C0A1A00001.quest_subtitle: "Craft aquaculture:tackle_box"
	quest.A17CA1C0A1A00001.quest_desc: [
		"Todo pescador sério tem uma caixa cheia de coisa que ele jura que usa."
		""
		"A Tackle Box guarda e equipa hooks, iscas, linhas e boias nas varas do Aquaculture."
	]
	quest.A17A46116E000001.title: "Mesa de aposentadoria"
	quest.A17A46116E000001.quest_subtitle: "Craft tide:angling_table"
	quest.A17A46116E000001.quest_desc: [
		"Quando a bancada comum cansa, nasce a mesa do pescador."
		""
		"A Angling Table do Tide cria partes especiais para sua vara modular."
	]
	quest.A17F150D00000001.title: "Vara de ferro forjada"
	quest.A17F150D00000001.quest_subtitle: "Primeira vara moderna"
	quest.A17F150D00000001.quest_desc: [
		"A vara improvisada ensinou humildade. A de ferro ensina confiança."
		""
		"Crie uma vara de ferro do Aquaculture para começar a usar melhorias de verdade."
	]
	quest.A17BA11700000001.title: "Verme do quintal"
	quest.A17BA11700000001.quest_subtitle: "Iscas: worm, minnow ou leech"
	quest.A17BA11700000001.quest_desc: [
		"Isca é o convite educado para o peixe fazer besteira."
		""
		"Comece com um worm. Depois teste minnow, leech e iscas especiais para controlar velocidade e alvo."
	]
	quest.A17A870100000001.title: "Anzol que não corta"
	quest.A17A870100000001.quest_subtitle: "Primeiro hook funcional"
	quest.A17A870100000001.quest_desc: [
		"O hook é a personalidade da vara."
		""
		"O Iron Hook ajuda a preservar isca. O Gold Hook abre o gosto por bônus melhores."
	]
	quest.A1711E8A80000001.title: "Linha e boia"
	quest.A1711E8A80000001.quest_subtitle: "Cosméticos com efeito"
	quest.A1711E8A80000001.quest_desc: [
		"Não é frescura se o peixe respeita."
		""
		"Linhas afetam alcance ou peso. Boias ajudam visualmente e deixam sua vara com cara de ferramenta própria."
	]
	quest.A17E901B00000001.title: "Equipa o pescador"
	quest.A17E901B00000001.quest_subtitle: "Use a Tackle Box"
	quest.A17E901B00000001.quest_desc: [
		"Agora enfia tudo na caixa e finge que foi planejado."
		""
		"Coloque a vara, encaixe hook, isca, linha e boia. Retire a vara pronta para teste."
	]
	quest.2279061F8FB1E455.title: "Rede de iniciante"
	quest.2279061F8FB1E455.quest_subtitle: "Pesque 5 vezes"
	quest.2279061F8FB1E455.quest_desc: [
		"Com equipamento montado, a paciencia vira metodo."
		""
		"Pesque algumas vezes e sinta como a montagem muda o ritmo da captura."
	]
	quest.A17BACC010000001.title: "A barra colorida"
	quest.A17BACC010000001.quest_subtitle: "Minigame do Tide"
	quest.A17BACC010000001.quest_desc: [
		"Aqui o peixe tenta te humilhar em tempo real."
		""
		"No minigame, clique quando a barra entrar na zona colorida. Errar demais pode custar a captura."
	]
	quest.7314C8334DF9DF87.title: "Águas abertas"
	quest.7314C8334DF9DF87.quest_subtitle: "Pesque no oceano"
	quest.7314C8334DF9DF87.quest_desc: [
		"O oceano é onde o pescador para de chamar lagoa de aventura."
		""
		"Biomas diferentes trazem peixes diferentes, principalmente com Aquaculture e Tide."
	]
	quest.A17D1A9100000001.title: "Diário do oceano"
	quest.A17D1A9100000001.quest_subtitle: "Fishing Journal"
	quest.A17D1A9100000001.quest_desc: [
		"História de pescador sem livro vira mentira sem prova."
		""
		"O diário registra espécies, habitats e descobertas. Use-o como catálogo da sua coleção."
	]
	quest.7BF920AB7D7891D4.title: "Aprendiz pescador — concluído"
	quest.7BF920AB7D7891D4.quest_subtitle: "Pesque 20 peixes"
	quest.7BF920AB7D7891D4.quest_desc: [
		"Você deixou de ser só alguém molhando barbante."
		""
		"Com 20 capturas, já entende equipamento, bioma e ritmo. A maré profunda vem depois."
	]

	quest.1922E0069FE0C4C8.title: "Fogueira do convés"
	quest.5C6A9F8A8B0E5857.title: "Primeiro prato de bordo"
	quest.650EFA7589F46DBE.title: "Cozinha do marinheiro"
	quest.0DEF33350ECF598C.title: "Aprendiz cozinheiro — concluído"

	quest.51CC2296EAA81F4A.title: "Oficina à beira-mar"
	quest.1800AE5691926726.title: "Bancada náutica"
	quest.3A9553A48AFC4357.title: "Embarcação simples"
	quest.034F98C3AF90CD51.title: "Aprendiz artesão — concluído"

	quest.0E5C288373769EE9.title: "Carta náutica rasgada"
	quest.6ADE74CA08C109B7.title: "Areia e maré"
	quest.09EA84EA8B5A47B0.title: "Leme nas mãos"
	quest.0B7DBA167854991E.title: "Aprendiz marinheiro — concluído"

	quest.514459B8E2867312.title: "Quatro ventos reunidos"
	quest.514459B8E2867312.quest_desc: [
		"Você fechou as quatro abas de &aAprendiz&r. Os veteranos do porto sussurram que há mares além da costa — rotas mais profundas e perigosas."
		""
		"Leia com atenção: o que vem agora não é pressa, é &ldquo;profundidade&rdquo;."
	]
	quest.646D9FE5612BFFFC.title: "Caminhos profundos do oceano"
	quest.646D9FE5612BFFFC.quest_desc: [
		"&6Pescador lendário&r caça histórias, não só comida."
		"&6Chef das profundezas&r transforma o RNG em banquete."
		"&6Artesão das lendas&r forja relíquias, não ferramentas."
		"&6Lorde dos oceanos&r domina segredos, não apenas mapas."
		""
		"A trilha &9Mestre&r exige repetição, exploração e domínio. Quando estiver pronto, marque esta missão."
	]
	quest.12753FFB6686B5F3.title: "Portão dos Mestres"
	quest.12753FFB6686B5F3.quest_subtitle: "Desbloqueia as quatro abas Mestre"
	quest.12753FFB6686B5F3.quest_desc: [
		"As abas &9Mestre&r estão liberadas. A progressão aqui é &lenta&r — alinhada ao manifesto (GOOD → LEGENDARY)."
		""
		"Conclua as quatro rotas de Mestre para fundar sua &2colônia portuária&r."
	]

	quest.45DB4E1B9BCC5C05.title: "Mestre das linhas"
	quest.357E90BE5994BAE2.title: "Emblema do mar aberto"
	quest.6D2FE5B89D57DC5A.title: "Mestre do tempero"
	quest.463D0E02AAFD20CD.title: "Brasão do sabor profundo"
	quest.33C318105923C519.title: "Mestre do estaleiro"
	quest.5E44EA72D1C2E021.title: "Selo do forjador do oceano"
	quest.7083A48389EDC4CE.title: "Mestre da carta náutica"
	quest.0483799ED346B468.title: "Astrolábio do abismo"

	quest.78A1E6167FAD8297.title: "O porto dos lendários"
	quest.78A1E6167FAD8297.quest_desc: [
		"Você provou maestria nas quatro rotas. Agora ergue-se um &2assentamento portuário&r — não uma vila qualquer, mas um refúgio de pescadores, artesãos, cozinheiros e marinheiros que vivem da pesca."
		""
		"Este guia usa &eMineColonies&r. Siga cada passo na ordem; os textos usam o tom do modpack (mares, piratas, guildas)."
	]
	quest.2404617F225A7E70.title: "Barraca de suprimentos do corsário"
	quest.2404617F225A7E70.quest_desc: [
		"Coloque a &eBarraca de Suprimentos&r (&osupply camp&r) onde deseja fundar o porto."
		""
		"Imagine um acampamento de contrabandistas convertido em entreposto legal: madeira, comida e ferramentas para quem vai enfrentar o oceano."
	]
	quest.444E61B131D641EF.title: "Cartório do porto (Prefeitura)"
	quest.444E61B131D641EF.quest_desc: [
		"Com o &6Cetro Dourado&r (Structurize), defina o terreno e construa a &ePrefeitura&r (&otown hall&r)."
		""
		"Este é o cartório onde se registra cada colonizador — pescadores, cozinheiros de bordo, carpinteiros navais e sentinelas contra piratas."
	]
	quest.1ACA906F0606778E.title: "Estaleiro: o construtor do cais"
	quest.1ACA906F0606778E.quest_desc: [
		"Contrate um &eConstrutor&r (&obuilder&r). Sem ele, nenhum galpão de redes nem armazém de peixe salgado sai do papel."
		""
		"Dica: mantenha blocos de madeira e pedra no armazém central para não atrasar obras."
	]
	quest.34AA9119C749FD4D.title: "Cabana do pescador da guilda"
	quest.34AA9119C749FD4D.quest_desc: [
		"Erga a &eCabana do Pescador&r. Colonos pescam automaticamente — alimentam a cozinha e o comércio do porto."
		""
		"Quanto maior o nível da cabana, mais o oceano vira economia estável para sua lenda."
	]
	quest.54E0CF4624409E16.title: "Cozinha do galeão"
	quest.54E0CF4624409E16.quest_desc: [
		"A &eCozinha&r transforma capturas em refeições. Cozinheiros de bordo são a ponte entre o &6Pescador&r e os buffs do &6Cozinheiro&r."
		""
		"Configure pratos prioritários para peixes de tier alto quando o sistema TLF estiver integrado."
	]
	quest.4837393A65B0CAB0.title: "Armazém dos mantimentos salgados"
	quest.4837393A65B0CAB0.quest_desc: [
		"O &eArmazém&r é o coração logístico: recebe peixes, entrega materiais aos construtores e alimenta a oficina."
		""
		"Sem armazém organizado, até o melhor marinheiro perde tempo voltando ao cais."
	]
	quest.6396E6E420AE3D5C.title: "Serraria do estaleiro"
	quest.6396E6E420AE3D5C.quest_desc: [
		"O &eLenhador&r fornece madeira para barcos, varas e expansão do cais. Artesãos agradecem cada tábua cortada."
	]
	quest.0C627CAAF33B340F.title: "Torre contra piratas"
	quest.0C627CAAF33B340F.quest_desc: [
		"Piratas e ilhéus hostis existem. A &eTorre de Guarda&r protege colonos e mantém a pesca noturna possível."
		""
		"Guardeiros também expandem a área da colônia — útil para novos cais."
	]
	quest.6325FF3640F27E4F.title: "Universidade das cartas náuticas"
	quest.6325FF3640F27E4F.quest_desc: [
		"A &eUniversidade&r pesquisa tecnologias: produção, velocidade de pesca, capacidade de armazém."
		""
		"Pense nela como a escola onde marinheiros e mestres compartilham mapas e segredos."
	]
	quest.499DAD451959A7D3.title: "Porto próspero — colônia fundada"
	quest.499DAD451959A7D3.quest_subtitle: "Sua vila marítima está de pé"
	quest.499DAD451959A7D3.quest_desc: [
		"O porto respira. Pescadores lançam redes, cozinheiros fervem caldeirões, artesãos consertam barcos e marinheiros traçam rotas."
		""
		"A última página do livro de missões aguarda: &6Suas Métricas&r — uma dedicatória à sua jornada."
	]

	quest.7762EE2CF2AD3279.title: "Relógio das marés"
	quest.7762EE2CF2AD3279.quest_desc: [
		"O jogo registra quanto tempo você navegou nesta lenda."
		""
		"Esta missão completa assim que você tiver qualquer tempo registrado em &estatísticas&r (&oplay time&r)."
		"No futuro, créditos dos desenvolvedores, versão do pack e totais aparecerão aqui."
	]
	quest.3C7A71620DE78192.title: "Dedicatória — Legendary Fishman"
	quest.3C7A71620DE78192.quest_desc: [
		"&6&lObrigado por jogar The Legendary Fishman.&r"
		""
		"Você passou do aprendiz ao mestre, fundou um porto e escreveu sua própria lenda nos oceanos."
		""
		"&7[Espaço reservado — preencher pelo autor:]&r"
		"• Tempo total de jogo"
		"• Peixes capturados / tier mais alto"
		"• Nome dos desenvolvedores"
		"• Links da comunidade"
		"• Mensagem da temporada"
		""
		"Que as marés sejam sempre a seu favor."
	]

	quest.tlf.toast.basico: "Fundamentos concluídos — rotas Aprendiz liberadas!"
	quest.tlf.toast.mestre: "Caminhos Profundos — trilha Mestre liberada!"
	quest.tlf.toast.colonia: "Porto fundado — sua colônia vive da pesca!"
	quest.tlf.toast.fim: "Lenda completa — obrigado por jogar!"
}
