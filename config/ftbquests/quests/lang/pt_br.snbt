	quest.3ABF451FD174FC74.title: "Faca do marujo"
	quest.3ABF451FD174FC74.quest_subtitle: "Farmer's Delight — faca de sílex"
	quest.3ABF451FD174FC74.quest_desc: [
		"Antes de pescar, aprenda a improvisar no cais."
		""
		"Tenha no inventário uma &efaca do Farmer's Delight&r (&7flint knife&r). Com ela você poderá preparar materiais e, mais adiante, &6cordas&r (&orope&r) para montar equipamento."
	]
	quest.1FD3C02A7F7B2188.title: "Corda improvisada"
	quest.1FD3C02A7F7B2188.quest_subtitle: "1× farmersdelight:rope"
	quest.1FD3C02A7F7B2188.quest_desc: [
		"Use a faca e os recursos do &eFarmer's Delight&r para obter uma &6corda&r."
		""
		"Ela substitui o barbante na única receita de vara permitida neste modpack."
	]
	quest.6B635D1717E56622.title: "Vara do aprendiz"
	quest.6B635D1717E56622.quest_subtitle: "3 gravetos + 2 cordas"
	quest.6B635D1717E56622.quest_desc: [
		"Monte sua primeira vara na bancada:"
		""
		"&7Padrão igual à vara vanilla&r, trocando &estring&r por &6corda&r:"
		"&8[ R ]&r"
		"&8[RS]&r"
		"&8[S  ]&r"
		""
		"R = corda, S = graveto. A vara do pack tem apenas &c10 de durabilidade&r — trate-a com cuidado."
	]
	quest.7515A04E6573E89D.title: "Lendo as marés (Tiers)"
	quest.7515A04E6573E89D.quest_desc: [
		"&7LOW&r — improviso. &fMEDIUM&r — estabilidade. &aGOOD&r — especialização."
		"&9GREAT&r — reconhecimento local. &5EXCELLENT&r — maestria. &dPERFECT&r — excelência rara. &6LEGENDARY&r — transcendência."
		""
		"Quatro rotas de &aAprendiz&r (rápidas) abrem em paralelo após esta etapa. Depois vêm &cCaminhos Profundos&r e a trilha &9Mestre&r (lenta)."
	]
	quest.2B63327585027AE2.title: "Fundamentos concluídos"
	quest.2B63327585027AE2.quest_subtitle: "Desbloqueia as 4 vertentes Aprendiz"
	quest.2B63327585027AE2.quest_desc: [
		"Você tem faca, corda e vara improvisada. As abas &aPescador&r, &6Cozinheiro&r, &7Artesão&r e &bMarinheiro&r liberam &oao mesmo tempo&r — pode fazer em qualquer ordem, mas &lcada aba&r é sequencial por dentro."
		""
		"Conclua &todas as quatro&r para abrir &cCaminhos Profundos&r."
	]

	quest.09F348FF8189073A.title: "Aprendiz do cais"
	quest.09F348FF8189073A.quest_desc: ["A rota do Pescador abre. Capture, observe biomas e acumule reputação no cais."]
	quest.2279061F8FB1E455.title: "Rede de iniciante"
	quest.2279061F8FB1E455.quest_subtitle: "Pesque 5 vezes"
	quest.7314C8334DF9DF87.title: "Águas abertas"
	quest.7314C8334DF9DF87.quest_subtitle: "Visite o oceano"
	quest.7BF920AB7D7891D4.title: "Aprendiz pescador — concluído"
	quest.7BF920AB7D7891D4.quest_desc: ["Você dominou o ritmo rápido da costa. Sua insígnia costeira aguarda o próximo maré."]

